# Application
NODE_ENV=development
PORT=3000

# External Services
PRODUCTS_SERVICE_URL=http://localhost:3001/products
PRODUCTS_SERVICE_TIMEOUT=5000

# Authentication
JWT_SECRET=your-jwt-secret-here

# Database
# Option 1: Prisma Dev (recommended for development)
# Run: npx prisma dev
# DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# Option 2: Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orders_db?schema=public"

# Option 3: Docker PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orders_db?schema=public"
